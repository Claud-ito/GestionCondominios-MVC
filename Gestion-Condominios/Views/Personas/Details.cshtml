@model Gestion_Condominios.Models.Persona
@{ViewData["Title"]="Detalle de persona";}<h1>@Model.Nombre @Model.Apellido</h1>@if(TempData["Mensaje Error"] is string error){<div class="alert alert-danger">@error</div>}<dl class="row"><dt class="col-sm-3">Documento</dt><dd class="col-sm-9">@Model.NroCI</dd><dt class="col-sm-3">Teléfono</dt><dd class="col-sm-9">@Model.Telefono</dd><dt class="col-sm-3">Correo</dt><dd class="col-sm-9">@Model.Correo</dd></dl><h2 class="h5">Unidades relacionadas</h2><ul>@foreach(var r in Model.UnidadPersonas){<li>@r.Unidad.Condominio.Nombre — @r.Unidad.NumeroUnidad (@r.TipoRelacion)</li>}</ul><a asp-action="Edit" asp-route-id="@Model.IdPersona" class="btn btn-secondary">Editar</a><form asp-action="Delete" asp-route-id="@Model.IdPersona" method="post" class="d-inline"><button class="btn btn-danger" onclick="return confirm('¿Eliminar esta ficha?');">Eliminar</button></form> <a asp-action="Index">Volver</a>
