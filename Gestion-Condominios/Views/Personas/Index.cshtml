@model IEnumerable<Gestion_Condominios.Models.Persona>
@{ ViewData["Title"]="Personas"; }<h1>Personas</h1><p><a asp-action="Create" class="btn btn-primary">Registrar persona</a></p><form method="get" class="mb-3"><input name="buscar" value="@ViewBag.Buscar" placeholder="Documento, nombre o apellido"/><button class="btn btn-outline-secondary">Buscar</button></form>@if(TempData["Mensaje Exito"] is string ok){<div class="alert alert-success">@ok</div>}@if(!Model.Any()){<div class="alert alert-info">No se encontraron personas.</div>}else{<table class="table"><thead><tr><th>Documento</th><th>Nombre</th><th>Teléfono</th><th>Correo</th><th></th></tr></thead><tbody>@foreach(var p in Model){<tr><td>@p.NroCI</td><td>@p.Apellido, @p.Nombre</td><td>@p.Telefono</td><td>@p.Correo</td><td><a asp-action="Details" asp-route-id="@p.IdPersona">Detalle</a> | <a asp-action="Edit" asp-route-id="@p.IdPersona">Editar</a></td></tr>}</tbody></table>}
