@model Gestion_Condominios.ViewModels.ReporteCobranzaVM
@{ ViewData["Title"] = "Reporte de cobranza"; }
<h1>Reporte de expensas y cobranza</h1>
<form method="get" class="row g-2 mb-3"><div class="col-md-3"><select asp-for="Filtro.IdCondominio" asp-items="Model.Condominios" class="form-select"><option value="">Todos los condominios</option></select></div><div class="col-md-3"><select asp-for="Filtro.IdUnidad" asp-items="Model.Unidades" class="form-select"><option value="">Todas las unidades</option></select></div><div class="col-md-2"><input asp-for="Filtro.Anio" class="form-control" placeholder="Año" /></div><div class="col-md-2"><input asp-for="Filtro.Mes" class="form-control" placeholder="Mes" /></div><div class="col-md-2"><button class="btn btn-secondary w-100">Consultar</button></div></form>
<div class="row mb-3"><div class="col">Facturado: <strong>@Model.TotalFacturado.ToString("N2")</strong></div><div class="col">Cobrado: <strong>@Model.TotalCobrado.ToString("N2")</strong></div><div class="col">Pendiente/vencido: <strong>@Model.TotalPendienteOVencido.ToString("N2")</strong></div><div class="col">Expensas: <strong>@Model.CantidadExpensas</strong></div></div>
<table class="table table-striped"><thead><tr><th>Condominio y unidad</th><th>Concepto/período</th><th>Monto</th><th>Vencimiento</th><th>Fecha pago</th><th>Condición</th></tr></thead><tbody>@foreach(var p in Model.Items){<tr><td>@p.Casa</td><td>@p.Concepto — @p.Periodo</td><td>@p.Monto.ToString("N2")</td><td>@p.FechaVencimiento.ToString("d")</td><td>@p.FechaPago?.ToString("d")</td><td>@p.Condicion</td></tr>}</tbody></table>
