@model IEnumerable<Gestion_Condominios.ViewModels.OcupacionUnidadViewModel>
@{ViewData["Title"]="Ocupaciones";}<h1>Gestión de ocupación</h1>@if(!Model.Any()){<div class="alert alert-info">No hay unidades registradas.</div>}else{<table class="table"><thead><tr><th>Condominio</th><th>Unidad</th><th>Estado</th><th>Ocupantes</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Unidad.Condominio.Nombre</td><td>@x.Unidad.NumeroUnidad</td><td>@(x.EstaOcupada?"OCUPADA":"DISPONIBLE")</td><td>@x.Ocupantes.Count</td><td><a asp-action="Gestionar" asp-route-id="@x.Unidad.IdUnidad" class="btn btn-primary btn-sm">Gestionar</a></td></tr>}</tbody></table>}
