@model Gestion_Condominios.ViewModels.OcupacionUnidadViewModel
@{ViewData["Title"]="Gestionar ocupación";var hayInquilino=Model.Ocupantes.Any(x=>x.TipoRelacion=="INQUILINO");}
<h1>Ocupación: @Model.Unidad.NumeroUnidad</h1><p class="text-muted">@Model.Unidad.Condominio.Nombre · Estado: <strong>@(Model.EstaOcupada?"OCUPADA":"DISPONIBLE")</strong></p>
@if(TempData["Mensaje Exito"] is string ok){<div class="alert alert-success">@ok</div>}@if(TempData["Mensaje Error"] is string error){<div class="alert alert-danger">@error</div>}
<h2 class="h4">Ocupantes actuales</h2>@if(!Model.Ocupantes.Any()){<p>No hay ocupantes. La primera asignación debe ser un inquilino.</p>}else{<table class="table"><thead><tr><th>Persona</th><th>Documento</th><th>Relación</th><th>Inicio</th><th></th></tr></thead><tbody>@foreach(var o in Model.Ocupantes){<tr><td>@o.Persona.Apellido, @o.Persona.Nombre</td><td>@o.Persona.NroCI</td><td>@o.TipoRelacion</td><td>@o.FechaInicio.ToString("d")</td><td>@if(o.TipoRelacion=="HABITANTE"){<form asp-action="RetirarHabitante" method="post"><input type="hidden" name="idUnidad" value="@Model.Unidad.IdUnidad"/><input type="hidden" name="idPersona" value="@o.IdPersona"/><button class="btn btn-outline-danger btn-sm" onclick="return confirm('¿Retirar a este habitante?');">Retirar</button></form>}</td></tr>}</tbody></table>}
<hr/><h2 class="h4">@(hayInquilino?"Agregar habitante":"Asignar inquilino")</h2><form asp-action="Asignar" method="post" class="row g-3"><input name="IdUnidad" value="@Model.Unidad.IdUnidad" type="hidden"/><input name="TipoRelacion" value="@(hayInquilino?"HABITANTE":"INQUILINO")" type="hidden"/><div class="col-md-6"><label class="form-label">Persona</label><select name="IdPersona" asp-items="ViewBag.Personas" class="form-select"><option value="">-- Seleccione --</option></select></div><div class="col-md-4"><label class="form-label">Fecha de inicio</label><input name="FechaInicio" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control"/></div><div class="col-md-2 align-self-end"><button class="btn btn-primary">@(hayInquilino?"Agregar":"Asignar")</button></div></form>
@if(hayInquilino){<hr/><h2 class="h4">Cambiar inquilino responsable</h2><form asp-action="CambiarInquilino" method="post" class="row g-3"><input name="IdUnidad" value="@Model.Unidad.IdUnidad" type="hidden"/><div class="col-md-6"><label class="form-label">Nuevo inquilino</label><select name="IdPersona" asp-items="ViewBag.Personas" class="form-select"><option value="">-- Seleccione --</option></select></div><div class="col-md-4"><label class="form-label">Fecha de inicio</label><input name="FechaInicio" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control"/></div><div class="col-md-2 align-self-end"><button class="btn btn-warning" onclick="return confirm('¿Cambiar el inquilino responsable?');">Cambiar</button></div></form><hr/><form asp-action="Desocupar" method="post"><input name="idUnidad" value="@Model.Unidad.IdUnidad" type="hidden"/><button class="btn btn-danger" onclick="return confirm('¿Desocupar la unidad? Se retirarán todas las relaciones, pero no se eliminarán las personas.');">Desocupar unidad</button></form>}<p class="mt-3"><a asp-action="Index">Volver</a></p>
