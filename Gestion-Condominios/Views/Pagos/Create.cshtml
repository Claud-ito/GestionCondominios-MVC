@model Gestion_Condominios.ViewModels.PagoCreateVM
@{ ViewData["Title"] = "Nueva expensa"; }
<h1>Nueva expensa</h1>
<form method="post" class="row g-3"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="col-12"><label asp-for="IdUnidad" class="form-label">Unidad ocupada</label><select asp-for="IdUnidad" asp-items="Model.Unidades" class="form-select"><option value="">Seleccione una unidad</option></select><span asp-validation-for="IdUnidad" class="text-danger"></span></div><div class="col-md-3"><label asp-for="Anio" class="form-label">Año</label><input asp-for="Anio" class="form-control" /></div><div class="col-md-3"><label asp-for="Mes" class="form-label">Mes</label><input asp-for="Mes" class="form-control" /></div><div class="col-md-3"><label asp-for="Monto" class="form-label"></label><input asp-for="Monto" class="form-control" /></div><div class="col-md-3"><label asp-for="FechaVencimiento" class="form-label">Vencimiento</label><input asp-for="FechaVencimiento" class="form-control" /></div><div class="col-12"><label asp-for="Concepto" class="form-label"></label><input asp-for="Concepto" class="form-control" /></div><div><button class="btn btn-primary">Guardar</button> <a asp-action="Index" class="btn btn-secondary">Cancelar</a></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
