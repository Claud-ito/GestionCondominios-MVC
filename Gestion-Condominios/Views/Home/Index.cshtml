@model Gestion_Condominios.ViewModels.InicioViewModel

@{
    ViewData["Title"] = "Inicio";
}

<div class="page-header">
    <h1>Panel de inicio</h1>
</div>

@if (Model.TotalCondominios == 0)
{
    <div class="alert alert-info" role="status">
        Aún no hay condominios registrados.
        <a asp-controller="Condominios" asp-action="Create" class="alert-link">Registra el primero</a>
        para comenzar.
    </div>
}

<div class="row g-3">
    <div class="col-12 col-sm-6 col-lg-4">
        <div class="panel metric-card">
            <div class="metric-value">@Model.TotalCondominios</div>
            <div class="metric-label">Condominios registrados</div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-4">
        <div class="panel metric-card">
            <div class="metric-value">@Model.TotalUnidades</div>
            <div class="metric-label">Casas registradas</div>
            <div class="small text-muted">@Model.UnidadesOcupadas ocupadas &middot; @Model.UnidadesDisponibles disponibles</div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-4">
        <div class="panel metric-card">
            <div class="metric-value">@Model.ExpensasPendientes</div>
            <div class="metric-label">Expensas pendientes</div>
            <div class="small text-muted">@Model.ExpensasVencidas vencidas</div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-4">
        <div class="panel metric-card">
            <div class="metric-value">@Model.MontoPendiente.ToString("N2")</div>
            <div class="metric-label">Monto pendiente de cobro</div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-4">
        <div class="panel metric-card">
            <div class="metric-value">@Model.VisitasAbiertas</div>
            <div class="metric-label">Visitas sin salida registrada</div>
        </div>
    </div>
</div>

<h2 class="h5 mt-4 mb-3">Accesos rápidos</h2>
<div class="d-flex flex-wrap gap-2">
    <a asp-controller="Condominios" asp-action="Index" class="btn btn-outline-primary">Condominios</a>
    @* Descomentar cada acceso cuando su controlador llegue a main:
    <a asp-controller="Unidades" asp-action="Index" class="btn btn-outline-primary">Casas</a>
    <a asp-controller="Personas" asp-action="Index" class="btn btn-outline-primary">Personas</a>
    <a asp-controller="Pagos" asp-action="Index" class="btn btn-outline-primary">Expensas</a>
    <a asp-controller="Visitantes" asp-action="Index" class="btn btn-outline-primary">Visitantes</a>
    <a asp-controller="Visitas" asp-action="Index" class="btn btn-outline-primary">Visitas</a>
    *@
</div>
