@model Gestion_Condominios.ViewModels.OcupacionUnidadViewModel
@{ ViewData["Title"]="Detalle de unidad"; } <h1>Unidad @Model.Unidad.NumeroUnidad</h1>
@if (TempData["Mensaje Error"] is string error) {<div class="alert alert-danger">@error</div>}<dl class="row"><dt class="col-sm-3">Condominio</dt><dd class="col-sm-9">@Model.Unidad.Condominio.Nombre</dd><dt class="col-sm-3">Tipo</dt><dd class="col-sm-9">@Model.Unidad.Tipo</dd><dt class="col-sm-3">Cuartos</dt><dd class="col-sm-9">@Model.Unidad.CantidadCuartos</dd><dt class="col-sm-3">Superficie</dt><dd class="col-sm-9">@Model.Unidad.SuperficieM2 m²</dd><dt class="col-sm-3">Tarifa mensual</dt><dd class="col-sm-9">@Model.Unidad.PagoMes</dd><dt class="col-sm-3">Estado</dt><dd class="col-sm-9">@(Model.EstaOcupada?"OCUPADA":"DISPONIBLE")</dd></dl><a asp-controller="Ocupaciones" asp-action="Gestionar" asp-route-id="@Model.Unidad.IdUnidad" class="btn btn-primary">Gestionar ocupación</a> <a asp-action="Edit" asp-route-id="@Model.Unidad.IdUnidad" class="btn btn-secondary">Editar</a>
<form asp-action="Delete" asp-route-id="@Model.Unidad.IdUnidad" method="post" class="d-inline"><button class="btn btn-danger" onclick="return confirm('¿Eliminar esta unidad? Esta acción no se puede deshacer.');">Eliminar</button></form> <a asp-action="Index">Volver</a>
