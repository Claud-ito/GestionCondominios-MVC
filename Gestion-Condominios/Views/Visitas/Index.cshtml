@model IEnumerable<Gestion_Condominios.Models.Visita>

@{
    ViewData["Title"] = "Control de Visitas";
}

<h2>Control de Visitas</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Registrar ingreso
    </a>
</p>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Visitante</th>
            <th>Condominio</th>
            <th>Casa</th>
            <th>Fecha y hora de ingreso</th>
            <th>Estado</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var visita in Model)
        {
            <tr>
                <td>
                    @visita.Visitante.Nombre
                    @visita.Visitante.Apellido
                </td>
                <td>@visita.Unidad.Condominio.Nombre</td>
                <td>@visita.Unidad.NumeroUnidad</td>
                <td>
                    @visita.FechaHoraIngreso.ToString("dd/MM/yyyy HH:mm")
                </td>
                <td>
                    @if (visita.FechaHoraSalida == null)
                    {
                        <span class="badge bg-warning text-dark">
                            En curso
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-success">
                            Finalizada
                        </span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
