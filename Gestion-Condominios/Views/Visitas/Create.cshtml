@{
    ViewData["Title"] = "Registrar Ingreso";
}

<h2>Registrar Ingreso de Visitante</h2>

<form asp-controller="Visitas"
      asp-action="Create"
      method="post">

    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly"
         class="text-danger"></div>

    <div class="mb-3">
        <label class="form-label">Visitante</label>

        <select name="IdVisitante"
                class="form-select"
                asp-items="ViewBag.Visitantes"
                required>
            <option value="">Seleccione un visitante</option>
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Casa / Unidad</label>

        <select name="IdUnidad"
                class="form-select"
                asp-items="ViewBag.Unidades"
                required>
            <option value="">Seleccione una casa</option>
        </select>
    </div>

    <button type="submit" class="btn btn-success">
        Registrar ingreso
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancelar
    </a>
</form>
